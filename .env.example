# Copy to .env and fill in. Never commit .env.

# Database — local docker-compose by default; use Supabase URLs in production.
DATABASE_URL=postgres://scrapers:scrapers@localhost:5432/scrapers
DIRECT_DATABASE_URL=postgres://scrapers:scrapers@localhost:5432/scrapers

# Secret mixed into suppression-list hashes (generate: openssl rand -hex 32).
SUPPRESSION_PEPPER=

# The only user allowed into the dashboard.
OWNER_EMAIL=

# Apify — 0 means stay within the free monthly credit.
APIFY_TOKEN=
APIFY_MONTHLY_CAP_USD=0

# Python worker (phase 1).
WORKER_URL=http://localhost:8000
WORKER_SHARED_SECRET=

# Google Sheets export (phase 2), base64-encoded service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional — not needed when Claude scores leads over MCP.
ANTHROPIC_API_KEY=

SENTRY_DSN=
MAX_JOB_LIMIT=1000
DEFAULT_RETENTION_DAYS=90

# Later, once a business or creator account exists:
# META_APP_ID=
# META_APP_SECRET=
# IG_BUSINESS_ACCOUNT_ID=
# IG_GRAPH_TOKEN=
