# Copy to .env and fill in. Never commit .env.

# Database — local docker-compose by default; use Supabase URLs in production.
DATABASE_URL=postgres://scrapers:scrapers@localhost:5432/scrapers
DIRECT_DATABASE_URL=postgres://scrapers:scrapers@localhost:5432/scrapers

# Secret mixed into suppression-list hashes (generate: openssl rand -hex 32).
SUPPRESSION_PEPPER=

# Owner email: recorded on projects and given access to new Google Sheets.
OWNER_EMAIL=

# Dashboard (apps/web). Generate secrets with: openssl rand -hex 32
DASHBOARD_PASSWORD=
AUTH_SECRET=
CRON_SECRET=
# Public URL of the deployment, e.g. https://scrapers.vercel.app
APP_URL=
# Seconds one serverless call may spend processing jobs (below maxDuration 300).
DRAIN_BUDGET_SECONDS=240

# Apify — total monthly ceiling in USD; 0 = account limit (the free credit on the free plan).
APIFY_TOKEN=
APIFY_MONTHLY_CAP_USD=0

# Python worker (services/ig-worker): Instaloader, no login.
WORKER_URL=http://localhost:8000
# Generate with: openssl rand -hex 32
WORKER_SHARED_SECRET=
# Requests per minute from Node to the worker.
WORKER_RATE_PER_MINUTE=20
# Minimum seconds between Instagram requests inside the worker.
MIN_INTERVAL_SECONDS=3

# Google Sheets export: service-account JSON (raw or base64).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Telegram (idea from the Spir bot): notifications and the login code.
# Create a bot with @BotFather, send it a message, and put your chat id (from @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to "off" to disable the Telegram login code in an emergency.
TWO_FACTOR=
# Public account fetched by the daily provider check.
CANARY_USERNAME=instagram

# Browser push (generate with: pnpm scrapers push-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Reuse profiles fetched within this many days (saves Apify credit). 0 disables.
PROFILE_CACHE_DAYS=7
# Weekly summary: 0 = Sunday ... 5 = Friday, in this time zone.
WEEKLY_SUMMARY_DAY=5
TIME_ZONE=Asia/Baghdad
# Requests per minute per API key on MCP.
MCP_RATE_PER_MINUTE=120
# Worker only: residential proxy and random extra wait between Instagram requests.
PROXY_URL=
JITTER_SECONDS=2

# Optional AI scoring — not needed when Claude scores leads over MCP.
ANTHROPIC_API_KEY=

SENTRY_DSN=
MAX_JOB_LIMIT=1000
DEFAULT_RETENTION_DAYS=90

# Optional: official Graph API (Business Discovery). Needs your own business or
# creator Instagram account linked to a Facebook page and a Meta app.
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_TOKEN=
META_GRAPH_VERSION=v23.0
