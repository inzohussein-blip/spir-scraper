{
  "name": "scrapers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @scrapers/db generate",
    "db:migrate": "pnpm --filter @scrapers/db migrate",
    "scrapers": "node apps/cli/dist/bin.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
