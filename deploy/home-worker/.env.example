# The same value as WORKER_SHARED_SECRET on Vercel (openssl rand -hex 32).
WORKER_SHARED_SECRET=

# Cloudflare Zero Trust, Networks, Tunnels, Create a tunnel (Cloudflared), copy the token.
# Public hostname of the tunnel: e.g. worker.example.com  ->  http://ig-worker:8000
TUNNEL_TOKEN=

# Optional: residential proxies, comma separated. The home IP is used first in the
# rotation; when Instagram blocks an exit it rests and the next one is used.
# PROXY_URLS=http://user:pass@gate.provider.com:7777,http://user:pass@gate2.provider.com:7777

# Seconds between two Instagram requests, plus a random 0..JITTER_SECONDS.
MIN_INTERVAL_SECONDS=3
JITTER_SECONDS=2
# How long a blocked exit rests first (doubles on each block in a row, at most 6 hours).
EXIT_COOLDOWN_SECONDS=900
