{
  "manifest_version": 3,
  "name": "مساعد Scrapers",
  "short_name": "Scrapers",
  "version": "0.1.0",
  "description": "مساعد تصفح بالذكاء الاصطناعي (Claude أو OpenAI أو Gemini أو نموذج محلي) يقرأ حسابات إنستقرام العامة ويحفظ العملاء في منصة Scrapers.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://api.deepseek.com/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "مساعد Scrapers",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
