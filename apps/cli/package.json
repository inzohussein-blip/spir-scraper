{
  "name": "@scrapers/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "scrapers": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
